# DashScope 模型配置（请替换为自己的密钥）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
DASHSCOPE_REASON_MODEL=qwen3.7-plus
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding

# SerpAPI 配置，注册地址：https://serpapi.com/
SERPAPI_KEY=your-serpapi-key
SEARCH_RESULT_COUNT=10

# 本地 MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=assist_gen

# 本地 Neo4j 数据库配置
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# 本地 Redis 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_EXPIRE=3600
REDIS_CACHE_THRESHOLD=0.90

# JWT 配置（SECRET_KEY 请替换为强随机字符串，例如 openssl rand -hex 32 的结果）
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 允许跨域的前端来源（JSON 数组格式）；生产环境为同源部署可保持默认
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Microsoft GraphRAG 配置
GRAPHRAG_PROJECT_DIR=llm_backend/app/graphrag
GRAPHRAG_DATA_DIR=data
GRAPHRAG_QUERY_TYPE=local
GRAPHRAG_RESPONSE_TYPE=text
GRAPHRAG_COMMUNITY_LEVEL=3
GRAPHRAG_DYNAMIC_COMMUNITY=false
